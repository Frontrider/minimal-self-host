{
	# DEBUG_MODE=true at build time sets this to "debug", which raises Caddy's own log level.
	{$CADDY_GLOBAL_DEBUG}
	# Tailscale serve terminates TLS and forwards over loopback.
	servers {
		trusted_proxies static 127.0.0.1/8
	}
}

http://:8080 {
    reverse_proxy 127.0.0.1:8639
}

# Application manager entry point for the host. The app builds absolute URLs
# from DOMAIN, so make them root-relative for this listener and drop the Secure
# cookie flag, which would otherwise prevent the session over plain HTTP.
http://:8082 {
    route {
        header {
            defer
            Location "^https?://[^/]+(/.*)$" "$1"
            Set-Cookie "(?i);\s*secure;\s*" "; "
            Set-Cookie "(?i);\s*secure\s*$" ";"
        }
        replace {
            "https://{file./var/environment/global-env/DOMAIN}/" "/"
            "http://{file./var/environment/global-env/DOMAIN}/" "/"
            # Some templates HTML-escape the scheme and separators.
            "https&#x3A;&#x2F;&#x2F;{file./var/environment/global-env/DOMAIN}&#x2F;" "/"
            "http&#x3A;&#x2F;&#x2F;{file./var/environment/global-env/DOMAIN}&#x2F;" "/"
        }
        reverse_proxy 127.0.0.1:90
    }
}

http://:8443 {
    reverse_proxy 127.0.0.1:17180
}

:80 {
    handle /__health {
        respond 200
    }
    @tailscale expression `"{$CADDY_HTTPS_MODE_ENABLED}" == "true"`
    handle @tailscale {
        redir https://{file./var/environment/global-env/DOMAIN}{uri} permanent
    }

    handle {
        reverse_proxy 127.0.0.1:90
    }

    log {
        output stdout
    }
}
