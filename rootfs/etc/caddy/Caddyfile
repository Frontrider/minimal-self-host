{
	# DEBUG_MODE=true at build time sets this to "debug", which raises Caddy's own log level.
	{$CADDY_GLOBAL_DEBUG}
	# Tailscale serve terminates TLS and forwards over loopback.
	servers {
		trusted_proxies static 127.0.0.1/8
	}
}

http://:8080 {
    reverse_proxy 127.0.0.1:8639
}

http://:8443 {
    reverse_proxy 127.0.0.1:17180
}

:80 {
    handle /__health {
        respond 200
    }
    @tailscale expression `"{$CADDY_HTTPS_MODE_ENABLED}" == "true"`
    handle @tailscale {
        redir https://{file./var/environment/global-env/DOMAIN}{uri} permanent
    }

    handle {
        reverse_proxy 127.0.0.1:90
    }

    log {
        output stdout
    }
}
