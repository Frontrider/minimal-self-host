{
	# DEBUG_MODE=true at build time sets this to "debug", which raises Caddy's own log level.
	{$CADDY_GLOBAL_DEBUG}
	# Tailscale serve terminates TLS and forwards over loopback.
	servers {
		trusted_proxies static 127.0.0.1/8
	}
}

:80 {
    # DOMAIN is written by the tailscale service once the node is up.
    redir https://{file./var/environment/global-env/DOMAIN}{uri} permanent

    log {
        output stdout
    }
}

# Fallback for requests that match no generated site, so the internal HTTP server always exists.
http://:8080 {
    respond 404
}

# Forward auth endpoint for Tailscale identity. Tailscale serve sets Tailscale-User-Login on every request
# it proxies, overwriting any client value. Routes in the core labels use it with:
#   forward_auth 127.0.0.1:9099 { uri / }
http://127.0.0.1:9099 {
    @tailscale_user header Tailscale-User-Login *
    handle @tailscale_user {
        header Tailscale-User-Login {http.request.header.Tailscale-User-Login}
        respond 200
    }
    respond 401
}

