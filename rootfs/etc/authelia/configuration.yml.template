server:
  # Caddy serves Authelia under /auth on the main site.
  address: 'tcp://0.0.0.0:9091/auth'
log:
  level: info
totp:
  disable: true
webauthn:
  disable: true
session:
  cookies:
    - domain: '__DOMAIN__'
      authelia_url: 'https://__DOMAIN__/auth'
storage:
  local:
    path: /var/lib/localhost/authelia/db.sqlite3
# No SMTP here: password reset messages are written to this file.
notifier:
  filesystem:
    filename: /var/lib/localhost/authelia/notification.txt
authentication_backend:
  ldap:
    implementation: custom
    address: 'ldap://172.30.53.2:3890'
    base_dn: 'dc=example,dc=com'
    user: 'uid=admin,ou=people,dc=example,dc=com'
    additional_users_dn: 'ou=people'
    users_filter: '(&({username_attribute}={input})(objectClass=person))'
    additional_groups_dn: 'ou=groups'
    groups_filter: '(&(member={dn})(objectClass=groupOfUniqueNames))'
    attributes:
      username: uid
      mail: mail
      display_name: displayName
      group_name: cn
access_control:
  default_policy: one_factor
