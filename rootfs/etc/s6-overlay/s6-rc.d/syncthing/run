#!/command/with-contenv sh
set -eu
exec 2>&1
export HOME=/data

if [ -f "/var/syncthing/config.xml" ]; then
  # Configs generated earlier as root point the default folder at /root/Sync.
  sed -i 's#/root/Sync#/var/syncthing/Sync#g' /var/syncthing/config.xml
  echo "syncthing config exists"
else
  s6-setuidgid files syncthing generate --home /var/syncthing/
  echo "syncthing config generated"
fi

python3 /etc/s6-overlay/scripts/merge_xml.py /usr/local/etc/syncthing-default/config.xml /var/syncthing/config.xml || exit 1

exec s6-setuidgid files syncthing serve --no-restart --home=/var/syncthing --gui-address=unix:///tmp/st.sock --gui-apikey=1234 --skip-port-probing --unpaused
