#!/command/with-contenv sh
set -eu
exec 2>&1

JF_DATA=/data/jellyfin
JF_CONFIG=$JF_DATA/config
REMOTEAUTH_PLUGIN_ID=RemoteAuth_2.0.0.0
REMOTEAUTH_CONFIG=$JF_DATA/plugins/configurations/Jellyfin.Plugin.RemoteAuth.xml
REMOTEAUTH_SECRET_FILE=/data/remoteauth_secret
mkdir -p $JF_CONFIG $JF_DATA/cache $JF_DATA/log $JF_DATA/plugins/configurations

# Copy the bundled plugin once. Later boots keep the installed copy.
if [ ! -d $JF_DATA/plugins/$REMOTEAUTH_PLUGIN_ID ]; then
    cp -r /opt/jellyfin/plugins-default/$REMOTEAUTH_PLUGIN_ID $JF_DATA/plugins/
fi

# Caddy sends this secret on every /jellyfin request. Generated once and shared through the file.
if [ ! -s $REMOTEAUTH_SECRET_FILE ]; then
    openssl rand -hex 32 > $REMOTEAUTH_SECRET_FILE
    chmod 600 $REMOTEAUTH_SECRET_FILE
fi
REMOTEAUTH_SECRET=$(cat $REMOTEAUTH_SECRET_FILE)

# Users are identified by the Tailscale headers that Caddy maps to these names. The plugin's
# settings are created once, so UI changes such as role mappings survive restarts. Only the secret
# is refreshed on each boot.
if [ ! -s $REMOTEAUTH_CONFIG ]; then
    cat > $REMOTEAUTH_CONFIG <<EOF
<?xml version="1.0" encoding="utf-8"?>
<PluginConfiguration>
  <Enabled>true</Enabled>
  <SecretHeaderName>X-Remote-Auth-Secret</SecretHeaderName>
  <SecretHeaderValue>$REMOTEAUTH_SECRET</SecretHeaderValue>
  <UserHeader>X-Remote-Auth-User</UserHeader>
  <EmailHeader>X-Remote-Auth-Email</EmailHeader>
  <DisplayNameHeader>X-Remote-Auth-Name</DisplayNameHeader>
  <GroupsHeader>X-Remote-Auth-Groups</GroupsHeader>
  <GroupsDelimiter>|</GroupsDelimiter>
  <AdminGroup>jellyfin-admins</AdminGroup>
  <AutoCreateUsers>true</AutoCreateUsers>
  <AllowPasswordLogin>true</AllowPasswordLogin>
  <DefaultRoleName>users</DefaultRoleName>
  <RoleMappings>
    <RoleMapping>
      <RoleName>users</RoleName>
      <IsAdmin>false</IsAdmin>
      <EnableAllLibraries>true</EnableAllLibraries>
      <EnableMediaPlayback>true</EnableMediaPlayback>
      <EnableRemoteAccess>true</EnableRemoteAccess>
      <EnableTranscoding>true</EnableTranscoding>
      <Priority>0</Priority>
    </RoleMapping>
  </RoleMappings>
</PluginConfiguration>
EOF
    chmod 600 $REMOTEAUTH_CONFIG
else
    sed -i "s|<SecretHeaderValue>.*</SecretHeaderValue>|<SecretHeaderValue>$REMOTEAUTH_SECRET</SecretHeaderValue>|" $REMOTEAUTH_CONFIG
fi

# Jellyfin reads its base URL from network.xml. Set it on every boot so the /jellyfin prefix survives.
NETWORK_XML=$JF_CONFIG/network.xml
if [ ! -s $NETWORK_XML ]; then
    cat > $NETWORK_XML <<XML
<?xml version="1.0" encoding="utf-8"?>
<NetworkConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <BaseUrl>/jellyfin</BaseUrl>
</NetworkConfiguration>
XML
else
    sed -i -e 's|<BaseUrl />|<BaseUrl>/jellyfin</BaseUrl>|' -e 's|<BaseUrl>[^<]*</BaseUrl>|<BaseUrl>/jellyfin</BaseUrl>|' $NETWORK_XML
fi

# Skip the first-run wizard only when the database exists. Jellyfin refuses to start with the flag set
# and no database, so a missing jellyfin.db keeps the wizard enabled.
SYSTEM_XML=$JF_CONFIG/system.xml
if [ -f $JF_DATA/data/jellyfin.db ]; then
    WIZARD_DONE=true
else
    WIZARD_DONE=false
fi
if [ ! -s $SYSTEM_XML ]; then
    cat > $SYSTEM_XML <<XML
<?xml version="1.0" encoding="utf-8"?>
<ServerConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <IsStartupWizardCompleted>$WIZARD_DONE</IsStartupWizardCompleted>
</ServerConfiguration>
XML
else
    sed -i "s|<IsStartupWizardCompleted>[a-z]*</IsStartupWizardCompleted>|<IsStartupWizardCompleted>$WIZARD_DONE</IsStartupWizardCompleted>|" $SYSTEM_XML
fi

chown -R files:files "$JF_DATA"
export HOME=$JF_DATA

exec s6-setuidgid files /opt/jellyfin/jellyfin \
    --datadir $JF_DATA \
    --configdir $JF_CONFIG \
    --cachedir $JF_DATA/cache \
    --logdir $JF_DATA/log
