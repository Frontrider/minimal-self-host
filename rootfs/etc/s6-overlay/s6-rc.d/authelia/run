#!/command/with-contenv sh
exec 2>&1
state=/var/lib/localhost/authelia
mkdir -p "$state"
# DOMAIN is written by the tailscale service once the node has a name.
until [ -s /var/environment/global-env/DOMAIN ]; do sleep 2; done
DOMAIN="$(cat /var/environment/global-env/DOMAIN)"
[ -s "$state/session_secret" ] || openssl rand -hex 32 > "$state/session_secret"
[ -s "$state/storage_key" ] || openssl rand -hex 32 > "$state/storage_key"
[ -s "$state/jwt_secret" ] || openssl rand -hex 32 > "$state/jwt_secret"
sed "s/__DOMAIN__/$DOMAIN/g" /etc/authelia/configuration.yml.template > "$state/configuration.yml"
export AUTHELIA_SESSION_SECRET_FILE="$state/session_secret"
export AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE="$state/storage_key"
export AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE="$state/jwt_secret"
export AUTHELIA_AUTHENTICATION_BACKEND_LDAP_PASSWORD="${LLDAP_LDAP_USER_PASS:?LLDAP_LDAP_USER_PASS must be set}"
exec authelia --config "$state/configuration.yml"
