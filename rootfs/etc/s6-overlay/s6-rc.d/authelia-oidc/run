#!/command/with-contenv sh
exec 2>&1
state=/var/lib/localhost/authelia
requests=/var/environment/global-env/oidc/requests
secrets=/var/environment/global-env/oidc/secrets
mkdir -p "$requests" "$secrets" "$state/clients"

# A request file named <client_id> holds the redirect URIs, one per line.
# The client secret is generated here, stored for the service to read, and Authelia is restarted once per batch.
register_pending() {
  changed=0
  for request in "$requests"/*; do
    [ -f "$request" ] || continue
    client_id="$(basename "$request")"
    [ -f "$state/clients/$client_id.yml" ] && continue

    secret="$(openssl rand -hex 32)"
    digest="$(authelia crypto hash generate pbkdf2 --password "$secret" | sed -n 's/^Digest: //p')"
    if [ -z "$digest" ]; then
      echo "Could not hash secret for $client_id"
      continue
    fi

    redirects="$(sed "s/.*/          - '&'/" "$request")"
    {
      printf "      - client_id: '%s'\n" "$client_id"
      printf "        client_name: '%s'\n" "$client_id"
      printf "        client_secret: '%s'\n" "$digest"
      printf "        public: false\n"
      printf "        redirect_uris:\n%s\n" "$redirects"
      printf "        scopes: ['openid', 'profile', 'email', 'groups']\n"
      printf "        authorization_policy: 'one_factor'\n"
    } > "$state/clients/$client_id.yml.tmp"
    mv "$state/clients/$client_id.yml.tmp" "$state/clients/$client_id.yml"

    printf '%s' "$secret" > "$secrets/$client_id"
    chmod 600 "$secrets/$client_id"
    echo "Registered OIDC client $client_id"
    changed=1
  done

  if [ "$changed" = 1 ]; then
    s6-svc -r /run/service/authelia
  fi
}

# Handle requests that already exist, then wait for filesystem events instead of polling.
register_pending
inotifywait -m -q -e close_write -e moved_to --format '%f' "$requests" | while read -r _; do
  register_pending
done
