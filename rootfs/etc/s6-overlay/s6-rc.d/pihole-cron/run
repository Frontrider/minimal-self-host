#!/command/with-contenv sh
exec 2>&1
until [ -s /etc/pihole/gravity.db ] && [ -S /dev/log ]; do sleep 1; done
# Cronie loads user tables through crontab; -c enables clustering, not a directory.
crontab /etc/pihole-cron/root || exit 1
# Keep job output in rsyslog rather than invoking BusyBox's incompatible sendmail.
exec crond -f -s
