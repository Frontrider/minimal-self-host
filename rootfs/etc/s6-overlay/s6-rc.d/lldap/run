#!/command/with-contenv sh
exec 2>&1
# LLDAP_LDAP_USER_PASS is the initial LDAP admin password. Authelia uses the same value to bind to LDAP.
if [ -z "${LLDAP_LDAP_USER_PASS:-}" ]; then
  echo "LLDAP_LDAP_USER_PASS must be set to the initial admin password" >&2
  exit 1
fi
state=/var/lib/localhost/lldap
mkdir -p "$state"
# Secrets are generated once and kept in the core state volume.
[ -s "$state/jwt_secret" ] || openssl rand -hex 32 > "$state/jwt_secret"
[ -s "$state/key_seed" ] || openssl rand -hex 32 > "$state/key_seed"
export LLDAP_JWT_SECRET="$(cat "$state/jwt_secret")"
export LLDAP_KEY_SEED="$(cat "$state/key_seed")"
export LLDAP_DATABASE_URL="sqlite://$state/users.db?mode=rwc"
# Must match base_dn in the Authelia template.
export LLDAP_LDAP_BASE_DN=dc=example,dc=com
# LDAP listens on core's internal address so the Jellyfin container can reach it; Authelia uses the same address.
export LLDAP_LDAP_HOST=172.30.53.2
export LLDAP_LDAP_PORT=3890
# Web UI on loopback only; Tailscale serves it on port 8443 and the /users page embeds it.
export LLDAP_HTTP_HOST=127.0.0.1
export LLDAP_HTTP_PORT=17180
cd /opt/lldap
# Runs beside the server: it waits for the API, then creates the service account.
sh /etc/lldap/provision-service-account.sh &
exec ./lldap run
