#!/bin/sh

if [ -n "${DOMAIN:-}" ]; then
    echo "DOMAIN is configured; skipping Anywherelan" >&2
    exit 1
fi

if [ -n "${TS_AUTH_KEY:-}" ]; then
    echo "Tailscale auth key configured; skipping Anywherelan" >&2
    exit 1
fi

# DOMAIN is published by the anywherelan service from its local API.
mkdir -p /var/environment/global-env
